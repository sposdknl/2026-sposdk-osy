Vagrant.configure("2") do |config|
  config.vm.box = "bento/freebsd-14.3"
  config.vm.hostname = "spos-zabbix8"
  config.ssh.insert_key = false

  config.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 22, host: 2211, host_ip: "127.0.0.1"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "osy-zabbix8-server"
    vb.memory = 4096
    vb.cpus = 2
  end

  # File provisioners use SSH/SCP and do not depend on the /vagrant shared folder.
  config.vm.provision "file", source: "scripts/sposdk-cert-days.sh", destination: "/tmp/sposdk-cert-days.sh"
  config.vm.provision "file", source: "scripts/configure-hosts.php", destination: "/tmp/configure-hosts.php"
  config.vm.provision "file", source: "export/sposdk.cz_hosts.yaml", destination: "/tmp/sposdk.cz_hosts.yaml"
  config.vm.provision "shell", path: "scripts/install.sh"
end
